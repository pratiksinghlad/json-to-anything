{
  "name": "json-to-anything",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "build:cf": "vite build --base=/",
    "preview": "vite preview",
    "test": "vitest",
    "predeploy": "npm run build",
    "postbuild": "node scripts/copy-404.js",
    "deploy": "npm run build && node scripts/copy-404.js && gh-pages -d build",
    "lint": "eslint . --max-warnings=0 --fix",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --target x86_64-pc-windows-msvc",
    "tauri:build": "tauri build",
    "build:windows": "pwsh ./build.ps1 -Architecture x64",
    "build:windows:arm64": "pwsh ./build.ps1 -Architecture arm64"
  },
  "dependencies": {
    "@emnapi/core": "1.9.2",
    "@emnapi/runtime": "1.9.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@iarna/toml": "^2.2.5",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "diff": "^8.0.4",
    "fast-xml-parser": "^5.3.3",
    "gh-pages": "^6.3.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^25.6.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "js-yaml": "^4.1.1",
    "papaparse": "^5.5.3",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.2.4",
    "react-router-dom": "^7.9.5",
    "react-simple-code-editor": "^0.14.1",
    "sass": "^1.93.3",
    "smol-toml": "^1.6.1",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svgr": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/diff": "^7.0.2",
    "@types/iarna__toml": "^2.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
